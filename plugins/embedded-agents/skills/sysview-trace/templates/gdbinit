set pagination off
target remote :3333

mon reset halt
maintenance flush register-cache

# Start recording when the app starts, so the trace also shows the tasks being
# created. The file path is relative to the folder OpenOCD was started in (the
# project root when you use "idf.py openocd"); an absolute path works too.
b app_main
commands
mon esp sysview_mcore start file://build_trace/trace.SVDat
c
end

c
# When you have recorded enough: Ctrl+C, then
#   mon esp sysview_mcore stop
#   quit
